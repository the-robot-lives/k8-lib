# k8-util-config.yaml — Unified configuration for k8-lib devops tools
# Copy to your project root and customize. This file is safe to commit.
#
# SECURITY: All secrets belong in the secrets_file (see below).
#   Do NOT put credentials, tokens, or keys in this file.
#
# PATHS: All path values are resolved relative to this file's directory.
#
# ENV OVERRIDE: Every value can be overridden by its K8_* environment
#   variable (e.g., K8_AWS_PROFILE overrides aws.profile).

apiVersion: k8-lib/v1

# --- Secrets File (gitignored, merged at load time) -------------------------
# Path relative to this file. Contains credentials (client IDs, secrets, etc.)
# See .k8-secrets.yaml.example for the template.
secrets_file: .k8-secrets.yaml

# --- Paths (relative to this file) ------------------------------------------
paths:
  helm_dir: helm                          # Helm charts root
  terraform_dir: terraform                # Terraform root
  projects_dir: repos/incubator/projects  # project.yaml discovery root

# --- AWS ---------------------------------------------------------------------
aws:
  profile: terraformer        # AWS CLI profile name
  # account_id: in secrets_file
  region: us-east-1

# --- Docker Registry ---------------------------------------------------------
docker:
  registry: ""                # Docker registry host (e.g., ops.noizu.com)

# --- Kubernetes --------------------------------------------------------------
kubernetes:
  namespace: default          # Default namespace
  staging_namespace: staging  # Staging namespace
  infra_namespace: infra      # Infrastructure namespace
  app_prefix: app             # App label prefix for staging pod selectors

# --- Infisical (Secrets Manager) ---------------------------------------------
# client_id and client_secret go in .k8-secrets.yaml
infisical:
  host: ""                    # Infisical API URL
  project_id: ""              # Infisical project ID

# --- Terraform ---------------------------------------------------------------
terraform:
  state_bucket: ""            # S3 bucket for Terraform state
  kms_alias: ""               # KMS alias for state encryption
  lock_table: terraform-lock  # DynamoDB lock table
  import_user: terraformer-import
  import_policy_name: TerraformerImportPolicy

# --- Helm OCI Registry -------------------------------------------------------
helm:
  oci_registry: ""            # e.g., oci://ghcr.io/your-org/helm-charts
  registry_host: ghcr.io
  # registry_user: in secrets_file

# --- Preferences -------------------------------------------------------------
preferences:
  diff_viewer: code           # code | kdiff3 | opendiff | meld | terminal
  admin_email: admin@example.com
  credentials_link: ""        # Link to credentials vault (1Password, etc.)

# --- Database ----------------------------------------------------------------
database:
  name: ""
  user_prefix: app
  pgbouncer_host: pgbouncer.default.svc.cluster.local

# --- Cluster Status Patterns (grep -E regex) ---------------------------------
status_patterns:
  db: "(timescaledb|mysqldb|redis|valkey)"
  search: "(manticore|elasticsearch|opensearch)"
  app: "(backend|frontend|wordpress|api|admin)"
  net: "(pgbouncer|proxysql|haproxy)"
  infra: "(infisical|signoz|karpenter|nginx-ingress|lb-controller|cert-manager)"
  job: "(indexer|migrat|job)"

# --- Cluster Layout -----------------------------------------------------------
nodepool_labels:
  general: karpenter
  indexer: "karpenter:indexer"
  managed: eks

# --- Deploy One-Off -----------------------------------------------------------
placement_exclude_pattern: "aws-node|kube-proxy|ebs-csi-node|efs-csi-node|signoz-node-agent|nginx-ingress"

# --- Deployment Tiers ---------------------------------------------------------
# Tier N completes before tier N+1 begins. Charts within a tier run in parallel.
tiers:
  - name: "Secrets Management"
    tier: 0
    charts:
      - infisical
  - name: "Data & Observability"
    tier: 1
    charts:
      - shared-postgres
      - shared-redis
  # - name: "Platform & Admin"
  #   tier: 2
  #   charts:
  #     - cockpit
  #     - headlamp
  # - name: "Core Applications"
  #   tier: 3
  #   charts:
  #     - my-app

# --- Namespace Overrides ------------------------------------------------------
# chart-name: target-namespace
# Overrides namespace resolution for charts where global.namespace doesn't match.
namespace_overrides: {}
  # nginx-ingress: ingress-nginx
  # my-app: apps-ns

# --- Timeout Overrides --------------------------------------------------------
# chart-name: timeout
# Override the default 5m Helm upgrade timeout for specific charts.
timeout_overrides: {}
  # my-database: 30m
  # my-backend: 15m
