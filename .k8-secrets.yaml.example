# .k8-secrets.yaml — Credential store for k8-lib tools
#
# DO NOT commit this file. Add to .gitignore:
#   .k8-secrets.yaml
#
# This file is merged on top of k8-util-config.yaml at load time.
# Environment variables always override values from both files.
#
# Copy this template and fill in your credentials:
#   cp .k8-secrets.yaml.example .k8-secrets.yaml

# --- AWS (sensitive) ---------------------------------------------------------
aws:
  account_id: ""              # AWS account ID for IAM validation

# --- Infisical Credentials ---------------------------------------------------
infisical:
  client_id: ""               # Universal Auth client ID
  client_secret: ""           # Universal Auth client secret

# --- Helm Registry Credentials -----------------------------------------------
helm:
  registry_user: ""           # OCI registry username (e.g., GitHub username)
