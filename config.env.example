# K8 Utils Configuration
# Copy to config.env and customize for your infrastructure

# AWS
K8_AWS_PROFILE="terraformer"
K8_AWS_ACCOUNT_ID=""
K8_AWS_REGION="us-east-1"

# Docker Registry
K8_DOCKER_REGISTRY=""

# Kubernetes
K8_NAMESPACE="default"
K8_STAGING_NAMESPACE="staging"
K8_INFRA_NAMESPACE="infra"

# Infisical
K8_INFISICAL_HOST=""
K8_INFISICAL_PROJECT_ID=""
K8_INFISICAL_CLIENT_ID=""
K8_INFISICAL_CLIENT_SECRET=""

# Terraform
K8_TF_DIR=""
K8_TF_STATE_BUCKET=""
K8_TF_KMS_ALIAS=""
K8_TF_LOCK_TABLE="terraform-lock"

# Credentials link (1Password, Vault, etc.)
K8_CREDENTIALS_LINK=""

# Helm OCI Registry (for helm-publish)
K8_HELM_OCI_REGISTRY="oci://ghcr.io/your-org/helm-charts"
K8_HELM_REGISTRY_HOST="ghcr.io"
K8_HELM_REGISTRY_USER=""

# Diff viewer for helm preview (code, kdiff3, opendiff, meld, terminal)
K8_DIFF_VIEWER="code"

# Admin email (for services like Directus)
K8_ADMIN_EMAIL="admin@example.com"

# Database
K8_DB_NAME=""
K8_DB_USER_PREFIX="app"
K8_PGBOUNCER_HOST="pgbouncer.default.svc.cluster.local"

# cluster-status: pod dashboard category patterns (grep -E regex)
K8_STATUS_DB_PATTERN="(timescaledb|mysqldb|redis|valkey)"
K8_STATUS_SEARCH_PATTERN="(manticore|elasticsearch|opensearch)"
K8_STATUS_APP_PATTERN="(backend|frontend|wordpress|api|admin)"
K8_STATUS_NET_PATTERN="(pgbouncer|proxysql|haproxy)"
K8_STATUS_INFRA_PATTERN="(infisical|signoz|karpenter|nginx-ingress|lb-controller|cert-manager)"
K8_STATUS_JOB_PATTERN="(indexer|migrat|job)"

# cluster-layout: nodepool name → display label mapping
K8_NODEPOOL_LABELS="general=karpenter,indexer=karpenter:indexer,managed=eks"

# deploy-one-off: DaemonSet pods to exclude from placement verification
K8_PLACEMENT_EXCLUDE_PATTERN="aws-node|kube-proxy|ebs-csi-node|efs-csi-node|signoz-node-agent|nginx-ingress"

# add-import-permissions: IAM user/policy for terraform import
K8_TF_IMPORT_USER="terraformer-import"
K8_TF_IMPORT_POLICY_NAME="TerraformerImportPolicy"
