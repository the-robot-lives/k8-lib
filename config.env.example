# K8 Utils Configuration
# Copy to config.env and customize for your infrastructure

# AWS
K8_AWS_PROFILE="terraformer"
K8_AWS_ACCOUNT_ID=""
K8_AWS_REGION="us-east-1"

# Docker Registry
K8_DOCKER_REGISTRY=""

# Kubernetes
K8_NAMESPACE="default"
K8_STAGING_NAMESPACE="staging"
K8_INFRA_NAMESPACE="infra"

# Infisical
K8_INFISICAL_HOST=""
K8_INFISICAL_PROJECT_ID=""
K8_INFISICAL_CLIENT_ID=""
K8_INFISICAL_CLIENT_SECRET=""

# Terraform
K8_TF_DIR=""
K8_TF_STATE_BUCKET=""
K8_TF_KMS_ALIAS=""
K8_TF_LOCK_TABLE="terraform-lock"

# Credentials link (1Password, Vault, etc.)
K8_CREDENTIALS_LINK=""

# Diff viewer for helm preview (code, kdiff3, opendiff, meld, terminal)
K8_DIFF_VIEWER="code"

# Admin email (for services like Directus)
K8_ADMIN_EMAIL="admin@example.com"
